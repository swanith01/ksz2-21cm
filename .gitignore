# =============================================================================
# Heavy simulation cache — never committed (multi-GB per seed).
# Small final products go in data/products/ instead (see data/README.md).
# =============================================================================
*.h5
*.hdf5
*.pkl
cache/
*/cache/
**/kSZ_maps/

# 21cmFAST's own on-disk cache, wherever it's pointed
_cache/
Boxes/
Output_files/

# =============================================================================
# Standard Python / Jupyter / OS noise
# =============================================================================
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
.env
*.log

# =============================================================================
# Local, machine-specific config overrides — commit configs/*.yaml itself,
# not a personal override of it
# =============================================================================
configs/local_*.yaml
configs/*_local.yaml

# =============================================================================
# Plots — regenerated by scripts/*.py and paper/figure_scripts/*.py;
# commit the ones that go in the actual paper via paper/figures/ instead
# (create that dir + drop the final PDFs there when you're ready)
# =============================================================================
plots/
*.png
*.pdf
!paper/figures/**
